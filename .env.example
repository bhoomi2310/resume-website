# =================================================================
# Bhoomi Gupta Portfolio - Environment Configuration Guide
# =================================================================

# -----------------------------------------------------------------
# 1. AI CHATBOT (Ask Bhoomi) - Choose ANY ONE provider
# -----------------------------------------------------------------

# Option A: Groq (Recommended - 100% Free, ultra-fast LLaMA 3.3)
# Get a free key in 30 seconds at: https://console.groq.com/keys
GROQ_API_KEY=

# Option B: Google Gemini (Free tier, fast & smart)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Option C: OpenAI (GPT-4o-mini)
# Get a key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Option D: DeepSeek (DeepSeek V3)
# Get a key at: https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# Note: If no key is configured, the chatbot automatically uses
# the built-in verified resume knowledge engine with zero errors.


# -----------------------------------------------------------------
# 2. CONTACT FORM / EMAIL DISPATCH - Choose ANY ONE provider
# -----------------------------------------------------------------

# Option A: Resend (Recommended - 3,000 free emails/month)
# Get a free key at: https://resend.com/api-keys
RESEND_API_KEY=

# Option B: Web3Forms (Free, zero setup form delivery)
# Get a free key at: https://web3forms.com
WEB3FORMS_ACCESS_KEY=

# Option C: Standard SMTP (e.g., Gmail App Password)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_gmail_app_password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
